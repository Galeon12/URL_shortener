# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. If left empty or unreachable,
# the app falls back to local JSON storage automatically.
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/url_shortener

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection URL. If Redis is unavailable, the app falls back
# to in-process rate limiting and no URL caching.
REDIS_URL=redis://127.0.0.1:6379

# ─── Application ─────────────────────────────────────────────────────────────
PORT=5000

# Public base URL used in short links.
# Auto-detected from tunnel.json / proxy headers if not set.
BASE_URL=https://your-public-domain.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max tokens (burst capacity) per IP
RATE_LIMIT_CAPACITY=10
# Tokens refilled per second
RATE_LIMIT_REFILL_RATE=1

# ─── Security ────────────────────────────────────────────────────────────────
# Allowed CORS origin (* for public APIs, or a specific domain)
CORS_ORIGIN=*
